@model PetShop.Models.User

@{
    ViewData["Title"] = "Xóa Người dùng";
}

<h1 class="mt-4">@ViewData["Title"]</h1>
<h3 class="text-danger">Bạn có chắc chắn muốn xóa người dùng này?</h3>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Quản lý Người dùng</a></li>
    <li class="breadcrumb-item active">Xóa</li>
</ol>

<div class="alert alert-danger">
    Hành động này không thể hoàn tác.
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Thông tin của: @Model.FullName</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FullName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FullName)</dd>
            <dt class="col-sm-3">Vai trò</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Role.RoleName)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="UserId" />
            <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </form>
    </div>
</div>