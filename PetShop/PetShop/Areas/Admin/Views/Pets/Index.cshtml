@model IEnumerable<PetShop.Models.Pet>

@{
    ViewData["Title"] = "Quản lý Thú cưng";
}

<h1 class="mt-4">@ViewData["Title"]</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
    <li class="breadcrumb-item active">Danh sách thú cưng</li>
</ol>

<p>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</p>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <i class="fas fa-table me-1"></i>
        Tất cả thú cưng
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="datatablesSimple">
                <thead>
                    <tr>
                        <th class="text-center">Hình ảnh</th>
                        <th>Tên thú cưng</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="~/images/pets/@item.ImageUrl" alt="@item.PetName" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/70x70/EFEFEF/AAAAAA&text=N/A" alt="No image" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" />
                                }
                            </td>
                            <td class="align-middle text-dark">@item.PetName</td>
                            <td class="align-middle text-dark">@item.Category?.CategoryName</td>
                            <td class="text-end fw-bold align-middle text-dark">@item.Price.ToString("N0") VNĐ</td>
                            <td class="text-center align-middle">
                                <a asp-action="Edit" asp-route-id="@item.PetId" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Details" asp-route-id="@item.PetId" class="btn btn-info btn-sm">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.PetId" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>